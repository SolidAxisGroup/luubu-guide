{
  "id": "settings-integrations-quickbooks",
  "kind": "howto",
  "area": "settings",
  "screen": "settings.common.sidebar.lcIntegrations",
  "title": "Connect QuickBooks",
  "blurb": "Sync invoices, sales and customers with QuickBooks.",
  "icon": "card",
  "minutes": 4,
  "keywords": [
    "quickbooks",
    "qbo",
    "accounting",
    "invoices",
    "sync",
    "bookkeeping"
  ],
  "steps": [
    {
      "id": "open-settings",
      "title": "Open Settings",
      "body": "Click **Settings** at the bottom of the left menu.",
      "target": [
        {
          "css": "#sb_settings"
        },
        {
          "text": "Settings",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/settings/"
      }
    },
    {
      "id": "open-integrations",
      "title": "Open Integrations",
      "body": "Click **Integrations** in the Settings menu.",
      "route": "^/settings/",
      "go": "/settings/lc-integrations",
      "target": [
        {
          "css": "[id='sb_common.sidebar.lcIntegrations']"
        },
        {
          "text": "Integrations",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/settings/lc-integrations"
      }
    },
    {
      "id": "card",
      "title": "Find QuickBooks",
      "body": "On the QuickBooks card, click **QB Connect**.",
      "route": "^/settings/lc-integrations",
      "go": "/settings/lc-integrations",
      "target": [
        {
          "text": "QB Connect",
          "tag": "button"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "QB Connect"
    },
    {
      "id": "options",
      "title": "Choose what to import",
      "body": "Pick your import options, like bringing in past invoices.",
      "route": "^/settings/lc-integrations",
      "go": "/settings/lc-integrations",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "login",
      "title": "Log in",
      "body": "Log in to QuickBooks and accept all permissions.",
      "route": "^/settings/lc-integrations",
      "go": "/settings/lc-integrations",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "what",
      "title": "What syncs",
      "body": "New invoices and sales go to QuickBooks. QuickBooks customers come into Luubu within a few minutes. Invoices made before connecting are not sent.",
      "route": "^/settings/lc-integrations",
      "go": "/settings/lc-integrations",
      "target": [
        {
          "coach": true
        }
      ]
    }
  ]
}
