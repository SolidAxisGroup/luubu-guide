{
  "id": "automation-birthday-message",
  "kind": "howto",
  "area": "automation",
  "screen": "automation.workflow",
  "title": "Send a birthday message",
  "blurb": "Wish customers happy birthday with a text or a small offer.",
  "icon": "megaphone",
  "minutes": 4,
  "keywords": [
    "birthday",
    "date of birth",
    "offer",
    "loyalty",
    "greeting",
    "message"
  ],
  "steps": [
    {
      "id": "open-automation",
      "title": "Open Automation",
      "body": "Click **Automation** in the left menu.",
      "target": [
        {
          "css": "#sb_automation"
        },
        {
          "text": "Automation",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/automation/"
      }
    },
    {
      "id": "open-workflow",
      "title": "Open Workflows",
      "body": "Click **Workflows** at the top.",
      "route": "^/automation/",
      "go": "/automation/workflows",
      "target": [
        {
          "css": "#tb_workflow"
        },
        {
          "text": "Workflows"
        }
      ],
      "advance": {
        "route": "^/automation/workflows(?!/settings)"
      }
    },
    {
      "id": "new-workflow",
      "title": "Start a new workflow",
      "body": "Click **Create Workflow** and start from scratch. At the top, rename it to something you will recognise later, like \"Birthday message\".",
      "route": "^/automation/workflows(?!/settings)",
      "go": "/automation/workflows",
      "target": [
        {
          "text": "Create Workflow"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Create Workflow"
    },
    {
      "id": "trigger",
      "title": "Use the birthday trigger",
      "body": "Click **Add New Trigger** and choose **Birthday Reminder**. It checks every morning at 8am for contacts with a birthday that day.",
      "route": "^/automation/",
      "go": "/automation/workflows",
      "target": [
        {
          "text": "Birthday Reminder"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Birthday Reminder",
      "tip": "It only works for contacts with a date of birth saved."
    },
    {
      "id": "timing",
      "title": "Pick the timing (optional)",
      "body": "Add a filter such as **Before Number of Days** if you want to send a few days early, for example to offer a booking.",
      "route": "^/automation/",
      "go": "/automation/workflows",
      "target": [
        {
          "text": "Before Number of Days"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Before Number of Days"
    },
    {
      "id": "message",
      "title": "Write the message",
      "body": "Add **Send SMS** or **Send Email**. Keep it warm and short. A small voucher or free add-on works well.",
      "route": "^/automation/",
      "go": "/automation/workflows",
      "target": [
        {
          "text": "Send SMS"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Send SMS"
    },
    {
      "id": "publish",
      "title": "Save, test and publish",
      "body": "Click **Save**. Run **Test Workflow** on your own contact, then switch **Draft** to **Publish** and save again.",
      "route": "^/automation/",
      "go": "/automation/workflows",
      "target": [
        {
          "text": "Publish"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Publish",
      "tip": "Nothing is sent until the workflow is published."
    }
  ]
}
