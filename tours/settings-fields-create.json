{
  "id": "settings-fields-create",
  "kind": "howto",
  "area": "settings",
  "screen": "settings.custom-fields-settings",
  "title": "Create a custom field",
  "blurb": "Store extra details like job type, property size or referral source.",
  "icon": "grid",
  "minutes": 4,
  "keywords": [
    "custom field",
    "create field",
    "dropdown",
    "contact field",
    "extra info",
    "form field"
  ],
  "steps": [
    {
      "id": "open-settings",
      "title": "Open Settings",
      "body": "Click **Settings** at the bottom of the left menu.",
      "target": [
        {
          "css": "#sb_settings"
        },
        {
          "text": "Settings",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/settings/"
      }
    },
    {
      "id": "open-custom-fields",
      "title": "Open Custom Fields",
      "body": "Click **Custom Fields** in the Settings menu.",
      "route": "^/settings/",
      "go": "/settings/fields",
      "target": [
        {
          "css": "[id='sb_custom-fields-settings']"
        },
        {
          "text": "Custom Fields",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/settings/fields"
      }
    },
    {
      "id": "object",
      "title": "Pick the record type",
      "body": "Choose Contact, Opportunity or Company. You cannot move a field to a different type later.",
      "route": "^/settings/fields",
      "go": "/settings/fields",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "create",
      "title": "Create a field",
      "body": "Click **Create field**.",
      "route": "^/settings/fields",
      "go": "/settings/fields",
      "target": [
        {
          "text": "Create field",
          "tag": "button"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Create field",
      "advance": "click"
    },
    {
      "id": "type",
      "title": "Pick a type",
      "body": "Choose the field type: text, number, date, dropdown, checkbox and more. Use a dropdown when answers come from a set list.",
      "route": "^/settings/fields",
      "go": "/settings/fields",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "details",
      "title": "Name and folder",
      "body": "Enter the field name, pick a folder, and add placeholder text if you like. The field key is filled in for you.",
      "route": "^/settings/fields",
      "go": "/settings/fields",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "save",
      "title": "Save",
      "body": "Check the live preview, then click **Create custom field**.",
      "route": "^/settings/fields",
      "go": "/settings/fields",
      "target": [
        {
          "text": "Create custom field",
          "tag": "button"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Create custom field"
    }
  ]
}
