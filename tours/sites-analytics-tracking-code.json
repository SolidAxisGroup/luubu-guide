{
  "id": "sites-analytics-tracking-code",
  "kind": "howto",
  "area": "sites",
  "screen": "sites.funnels",
  "title": "Add Google Analytics or Meta Pixel",
  "blurb": "Send your site visits to Google Analytics or your Facebook ads account.",
  "icon": "chart",
  "minutes": 4,
  "keywords": [
    "google analytics",
    "ga4",
    "meta pixel",
    "facebook pixel",
    "tracking code",
    "ads"
  ],
  "steps": [
    {
      "id": "open-sites",
      "title": "Open Sites",
      "body": "Click **Sites** in the left menu.",
      "target": [
        {
          "css": "#sb_sites"
        },
        {
          "text": "Sites",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/funnels-websites/"
      }
    },
    {
      "id": "open-tab",
      "title": "Open Funnels",
      "body": "Click **Funnels**, or **Websites** for a website.",
      "route": "^/(funnels-websites|analytics|blogs|wordpress|form-builder|survey-builder|quiz-builder|qr-codes|settings/domain)",
      "go": "/funnels-websites/funnels",
      "target": [
        {
          "css": "#tb_funnels"
        },
        {
          "text": "Funnels",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/funnels-websites/funnels"
      }
    },
    {
      "id": "open",
      "title": "Open the funnel settings",
      "body": "Open your funnel and go to its **Settings** tab.",
      "route": "^/funnels-websites/funnels",
      "go": "/funnels-websites/funnels",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "paste",
      "title": "Paste the code",
      "body": "Copy your tracking snippet from Google Analytics or Meta Events Manager and paste it into the head tracking code box. Save.",
      "route": "^/funnels-websites/funnels",
      "go": "/funnels-websites/funnels",
      "target": [
        {
          "coach": true
        }
      ],
      "tip": "Code here runs on every step. To track one page only, use **Tracking Code** inside that page in the builder."
    },
    {
      "id": "publish",
      "title": "Republish",
      "body": "Open each step and click **Publish** so the code goes live.",
      "route": "^/",
      "go": "/funnels-websites/funnels",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "check",
      "title": "Check it is working",
      "body": "Visit the live page, then look for your visit in Google Analytics real-time or Meta Events Manager test events.",
      "route": "^/",
      "go": "/funnels-websites/funnels",
      "target": [
        {
          "coach": true
        }
      ]
    }
  ]
}
