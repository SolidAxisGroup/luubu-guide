{
  "id": "settings-tags-create",
  "kind": "howto",
  "area": "settings",
  "screen": "settings.tags",
  "title": "Create and organise tags",
  "blurb": "Set up clear tags so your team labels contacts the same way.",
  "icon": "users",
  "minutes": 3,
  "keywords": [
    "create tag",
    "new tag",
    "tags",
    "label",
    "colour",
    "category"
  ],
  "steps": [
    {
      "id": "open-settings",
      "title": "Open Settings",
      "body": "Click **Settings** at the bottom of the left menu.",
      "target": [
        {
          "css": "#sb_settings"
        },
        {
          "text": "Settings",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/settings/"
      }
    },
    {
      "id": "open-tags",
      "title": "Open Tags",
      "body": "Click **Tags** in the Settings menu.",
      "route": "^/settings/",
      "go": "/settings/tags",
      "target": [
        {
          "css": "[id='sb_tags']"
        },
        {
          "text": "Tags",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/settings/tags"
      }
    },
    {
      "id": "new",
      "title": "New tag",
      "body": "Click **Create tag**.",
      "route": "^/settings/tags",
      "go": "/settings/tags",
      "target": [
        {
          "text": "Create tag",
          "tag": "button"
        },
        {
          "text": "New tag",
          "tag": "button"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Create tag",
      "advance": "click"
    },
    {
      "id": "name",
      "title": "Name it",
      "body": "Use short lowercase names your team will understand, like \"lead - website\" or \"customer - vip\".",
      "route": "^/settings/tags",
      "go": "/settings/tags",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "category",
      "title": "Category and colour",
      "body": "Pick a category and colour so related tags sit together and are easy to spot.",
      "route": "^/settings/tags",
      "go": "/settings/tags",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "save",
      "title": "Save",
      "body": "Save it. The tag is now ready to use on contacts, forms and workflows.",
      "route": "^/settings/tags",
      "go": "/settings/tags",
      "target": [
        {
          "coach": true
        }
      ]
    }
  ]
}
