{
  "id": "ai-conversation-bot-channels-modes",
  "kind": "howto",
  "area": "ai",
  "screen": "ai.ai-agents-conversation-ai",
  "title": "Switch a bot to Auto-Pilot",
  "blurb": "Move from approving drafts to letting the bot reply on its own, safely.",
  "icon": "chat",
  "minutes": 4,
  "keywords": [
    "auto pilot",
    "suggestive",
    "bot mode",
    "channels",
    "facebook",
    "instagram",
    "turn on bot"
  ],
  "steps": [
    {
      "id": "open-ai-agents",
      "title": "Open AI Agents",
      "body": "Click **AI Agents** in the left menu.",
      "target": [
        {
          "css": "[id='sb_AI Agents']"
        },
        {
          "text": "AI Agents",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/ai-agents/"
      }
    },
    {
      "id": "open-ai-agents-conversation-ai",
      "title": "Open Conversation AI",
      "body": "Click the **Conversation AI** tab.",
      "route": "^/ai-agents/",
      "go": "/ai-agents/conversation-ai",
      "target": [
        {
          "css": "#tb_ai-agents-conversation-ai"
        },
        {
          "text": "Conversation AI"
        }
      ],
      "advance": {
        "route": "^/ai-agents/conversation-ai"
      }
    },
    {
      "id": "open",
      "title": "Open the bot",
      "body": "Click the bot you want to change.",
      "route": "^/ai-agents/conversation-ai",
      "go": "/ai-agents/conversation-ai",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "settings",
      "title": "Open Bot Settings",
      "body": "Click **Bot Settings**.",
      "route": "^/ai-agents/conversation-ai",
      "go": "/ai-agents/conversation-ai",
      "target": [
        {
          "text": "Bot Settings"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Bot Settings"
    },
    {
      "id": "channels",
      "title": "Add channels",
      "body": "Tick more channels once you trust it, like **Facebook** and **Instagram** messages.",
      "route": "^/ai-agents/conversation-ai",
      "go": "/ai-agents/conversation-ai",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "autopilot",
      "title": "Choose Auto-Pilot",
      "body": "Change the mode from **Suggestive** to **Auto-Pilot**. The bot now replies without waiting for you.",
      "route": "^/ai-agents/conversation-ai",
      "go": "/ai-agents/conversation-ai",
      "target": [
        {
          "text": "Auto-Pilot"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Auto-Pilot",
      "tip": "Run Suggestive for a week first. If you rarely edit its drafts, it is ready."
    },
    {
      "id": "limit",
      "title": "Cap the replies",
      "body": "Set **Maximum messages a Bot can send in a Conversation**. Around 10 to 25 suits FAQs and lead capture. After that it goes quiet and you take over.",
      "route": "^/ai-agents/conversation-ai",
      "go": "/ai-agents/conversation-ai",
      "target": [
        {
          "text": "Maximum messages a Bot can send in a Conversation"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Maximum messages a Bot can send in a Conversation"
    },
    {
      "id": "save",
      "title": "Save",
      "body": "Click **Save**. Marking a conversation as read in Conversations wakes a sleeping bot back up.",
      "route": "^/ai-agents/conversation-ai",
      "go": "/ai-agents/conversation-ai",
      "target": [
        {
          "coach": true
        }
      ]
    }
  ]
}
