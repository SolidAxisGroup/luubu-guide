{
  "id": "memberships-page-credentials",
  "kind": "page",
  "area": "memberships",
  "screen": "memberships.certificates",
  "title": "Tour: Credentials",
  "blurb": "Design certificates and badges and see every one you have issued.",
  "icon": "star",
  "minutes": 2,
  "keywords": [
    "certificates",
    "credentials",
    "badges",
    "course completion",
    "award"
  ],
  "steps": [
    {
      "id": "open-memberships",
      "title": "Open Memberships",
      "body": "Click **Memberships** in the left menu.",
      "target": [
        {
          "css": "#sb_memberships"
        },
        {
          "text": "Memberships",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/memberships/"
      }
    },
    {
      "id": "open-credentials",
      "title": "Open Credentials",
      "body": "Click **Credentials**. Certificates and badges live here.",
      "route": "^/memberships/",
      "go": "/memberships/certificates/create-certificates",
      "target": [
        {
          "css": "#tb_certificates"
        },
        {
          "text": "Credentials",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/memberships/certificates"
      }
    },
    {
      "id": "templates",
      "title": "Templates",
      "body": "Your certificate and badge designs are your templates. Use the three dots on one to edit, clone or delete it.",
      "route": "^/memberships/certificates",
      "go": "/memberships/certificates/create-certificates",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "issued",
      "title": "Issued certificates",
      "body": "**Issued Certificates** lists every certificate sent, who got it and when.",
      "route": "^/memberships/certificates",
      "go": "/memberships/certificates/create-certificates",
      "target": [
        {
          "text": "Issued Certificates"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Issued Certificates"
    },
    {
      "id": "send",
      "title": "Send one by hand",
      "body": "Use **Send** on a template to issue a certificate yourself, for example after an in-person workshop.",
      "route": "^/memberships/certificates",
      "go": "/memberships/certificates/create-certificates",
      "target": [
        {
          "text": "Send"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Send"
    },
    {
      "id": "next",
      "title": "What's next",
      "body": "Next: try **Design a certificate** from the Guide.",
      "route": "^/memberships/certificates",
      "go": "/memberships/certificates/create-certificates",
      "target": [
        {
          "coach": true
        }
      ]
    }
  ]
}
