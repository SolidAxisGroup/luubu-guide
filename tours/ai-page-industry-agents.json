      "route": "^/ai-agents/industry-agents",
      "go": "/ai-agents/industry-agents",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "browse",
      "title": "Browse by industry",
      "body": "Look for your field, such as trades, health, beauty or real estate, and read what each agent does.",
      "route": "^/ai-agents/industry-agents",
      "go": "/ai-agents/industry-agents",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "pick",
      "title": "Pick one to start",
      "body": "Choose the agent closest to your business. You can change anything after it is added.",
      "route": "^/ai-agents/industry-agents",
      "go": "/ai-agents/industry-agents",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "next",
      "title": "Next step",
      "body": "Next: try **Set up an industry agent** from the Guide.",
      "route": "^/ai-agents/industry-agents",
      "go": "/ai-agents/industry-agents",
      "target": [
        {
          "coach": true
        }
      ]
