{
  "id": "reporting-page-appointments",
  "kind": "page",
  "area": "reporting",
  "screen": "reporting.appointment-report",
  "title": "Tour: Appointment report",
  "blurb": "Bookings, cancellations and your busiest calendars and days.",
  "icon": "calendar",
  "minutes": 2,
  "keywords": [
    "appointments",
    "bookings",
    "appointment report",
    "cancellations",
    "no shows",
    "calendar"
  ],
  "steps": [
