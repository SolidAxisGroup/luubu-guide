      "body": "The top numbers count booked, confirmed, cancelled and new appointments.",
      "route": "^/reporting/appointment",
      "go": "/reporting/appointment",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "sources",
      "title": "Where bookings come from",
      "body": "See which channels and funnels bring bookings, and which staff take the most.",
      "route": "^/reporting/appointment",
      "go": "/reporting/appointment",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "top",
      "title": "Top calendars and days",
