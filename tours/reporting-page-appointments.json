        {
          "css": "#sb_reporting"
        },
        {
          "text": "Reporting",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/reporting/"
      }
    },
    {
      "id": "open-appointment-report",
      "title": "Open Appointment Report",
      "body": "Click **Appointment Report**. Your booking numbers show here.",
      "route": "^/reporting/",
      "go": "/reporting/appointment",
      "target": [
        {
          "css": "#tb_appointment-report"
        },
        {
          "text": "Appointment Report",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/reporting/appointment"
      }
    },
    {
      "id": "status",
