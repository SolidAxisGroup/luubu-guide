      "route": "^/reporting/appointment",
      "go": "/reporting/appointment",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "next",
      "title": "What's next",
      "body": "Next: try **See how bookings are going** from the Guide.",
