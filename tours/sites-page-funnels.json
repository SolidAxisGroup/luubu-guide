{
  "id": "sites-page-funnels",
  "kind": "page",
  "area": "sites",
  "screen": "sites.funnels",
  "title": "Tour the Funnels page",
  "blurb": "See where your landing pages and sales funnels live and how to start one.",
  "icon": "page",
  "minutes": 2,
  "keywords": [
    "funnels",
    "landing page",
    "sales page",
    "opt in",
    "tour",
    "overview"
  ],
  "steps": [
    {
      "id": "open-sites",
      "title": "Open Sites",
      "body": "Click **Sites** in the left menu.",
      "target": [
        {
          "css": "#sb_sites"
        },
        {
          "text": "Sites",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/funnels-websites/"
      }
    },
    {
      "id": "open-tab",
      "title": "Open Funnels",
      "body": "Click **Funnels**. A funnel is one page, or a short run of pages, built for one goal: get a lead or make a sale.",
      "route": "^/(funnels-websites|analytics|blogs|wordpress|form-builder|survey-builder|quiz-builder|qr-codes|settings/domain)",
      "go": "/funnels-websites/funnels",
      "target": [
        {
          "css": "#tb_funnels"
        },
        {
          "text": "Funnels",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/funnels-websites/funnels"
      }
    },
    {
      "id": "new-button",
      "title": "Start a funnel",
      "body": "**New funnel** starts a fresh one. Start **From blank** or pick one **From templates**.",
      "route": "^/funnels-websites/funnels",
      "go": "/funnels-websites/funnels",
      "target": [
        {
          "css": "#create-new-button"
        },
        {
          "css": "#positive-empty-state"
        },
        {
          "text": "New funnel",
          "tag": "button"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "New funnel"
    },
    {
      "id": "list",
      "title": "Your funnels",
      "body": "Every funnel you build shows in this list. Click one to open its steps, stats, sales and settings. Use the three-dot menu on a funnel to clone or move it into a folder.",
      "route": "^/funnels-websites/funnels",
      "go": "/funnels-websites/funnels",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "next",
      "title": "What next",
      "body": "Next: try **Edit a page in the builder** from the Guide, then **Publish a funnel on your domain**.",
      "route": "^/funnels-websites/funnels",
      "go": "/funnels-websites/funnels",
      "target": [
        {
          "coach": true
        }
      ]
    }
  ]
}
