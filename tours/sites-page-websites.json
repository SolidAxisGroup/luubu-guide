{
  "id": "sites-page-websites",
  "kind": "page",
  "area": "sites",
  "screen": "sites.websites",
  "title": "Tour the Websites page",
  "blurb": "See where your multi-page websites live and how to start one.",
  "icon": "globe",
  "minutes": 2,
  "keywords": [
    "website",
    "site",
    "pages",
    "homepage",
    "tour",
    "overview"
  ],
  "steps": [
    {
