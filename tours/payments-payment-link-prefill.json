{
  "id": "payments-payment-link-prefill",
  "kind": "howto",
  "area": "payments",
  "screen": "payments.payment-links",
  "title": "Pre-fill a payment link",
  "blurb": "Save customers typing by filling their details in the link.",
  "icon": "card",
  "minutes": 3,
  "keywords": [
    "prefill",
    "payment link",
    "redirect",
    "thank you page",
    "url parameters",
    "advanced"
  ],
  "steps": [
    {
      "id": "open-payments",
      "title": "Open Payments",
      "body": "Click **Payments** in the left menu.",
      "target": [
        {
          "css": "#sb_payments"
        },
        {
          "text": "Payments",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/payments/"
      }
    },
    {
      "id": "tab-payment-links",
      "title": "Open Payment Links",
      "body": "Click **Payment Links** along the top.",
      "route": "^/payments/",
      "go": "/payments/v2/paymentlinks",
      "target": [
        {
          "css": "#tb_payment-links"
        },
        {
          "text": "Payment Links",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/payments/v2/paymentlinks"
      }
    },
    {
      "id": "copy",
      "title": "Copy your link",
      "body": "Open a payment link and copy its URL.",
      "route": "^/payments/v2/paymentlinks",
      "go": "/payments/v2/paymentlinks",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "details",
      "title": "Add their details",
      "body": "Add ?firstName=Aroha&email=aroha@example.co.nz to the end of the link. Use & between each extra detail.",
      "route": "^/payments/v2/paymentlinks",
      "go": "/payments/v2/paymentlinks",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "redirect",
      "title": "Send them somewhere after",
      "body": "Add redirectUrl= and a web address to send buyers to your thank-you page once they pay.",
      "route": "^/payments/v2/paymentlinks",
      "go": "/payments/v2/paymentlinks",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "test",
      "title": "Test it",
      "body": "Open the new link yourself to check the details fill in before you send it.",
      "route": "^/payments/v2/paymentlinks",
      "go": "/payments/v2/paymentlinks",
      "target": [
        {
          "coach": true
        }
      ]
    }
  ]
}
