{
  "id": "calendars-set-availability",
  "kind": "howto",
  "area": "calendars",
  "screen": "calendars.calendar-settings-top",
  "title": "Set your working hours",
  "blurb": "Tell Luubu when people can book you, including holidays and buffers.",
  "icon": "calendar",
  "minutes": 4,
  "keywords": [
    "availability",
    "hours",
    "working hours",
    "schedule",
    "public holiday",
    "buffer",
    "time off"
  ],
  "steps": [
    {
      "id": "open-calendars",
      "title": "Open Calendars",
      "body": "Click **Calendars** in the left menu.",
      "target": [
        {
          "css": "#sb_calendars"
        },
        {
          "text": "Calendars",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/calendars/"
      }
    },
    {
      "id": "tab-calendar-settings-top",
      "title": "Open Calendar Settings",
      "body": "Click **Calendar Settings** along the top. This is where every booking calendar is built and edited.",
      "route": "^/calendars/",
      "go": "/settings/calendars",
      "target": [
        {
          "css": "#tb_preferences"
        },
        {
          "css": "#tb_calendar-settings-top"
        },
        {
          "text": "Calendar settings",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/settings/calendars"
      }
    },
    {
      "id": "tab",
      "title": "Open Availability",
      "body": "Click the **Availability** tab.",
      "route": "^/settings/calendars",
      "go": "/settings/calendars",
      "target": [
        {
          "text": "Availability"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Availability"
    },
    {
      "id": "schedule",
      "title": "Make a schedule",
      "body": "Click **Create Schedule**, name it (say \"Standard week\") and create it.",
      "route": "^/settings/calendars",
      "go": "/settings/calendars",
      "target": [
        {
          "text": "Create Schedule",
          "tag": "button"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Create Schedule"
    },
    {
      "id": "hours",
      "title": "Set weekly hours",
      "body": "Set your hours for each day, e.g. Mon to Fri 8am to 5pm. Check the time zone is Pacific/Auckland.",
      "route": "^/settings/calendars",
      "go": "/settings/calendars",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "override",
      "title": "Add days off",
      "body": "Use a date-specific override for Waitangi Day, Christmas or a day at the dentist.",
      "route": "^/settings/calendars",
      "go": "/settings/calendars",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "apply",
      "title": "Apply it to calendars",
      "body": "Choose which calendars use this schedule, then save.",
      "tip": "Inside each calendar you can also set a buffer between bookings and a minimum notice, like 24 hours.",
      "route": "^/settings/calendars",
      "go": "/settings/calendars",
      "target": [
        {
          "coach": true
        }
      ]
    }
  ]
}
