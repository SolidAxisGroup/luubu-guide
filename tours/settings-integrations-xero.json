{
  "id": "settings-integrations-xero",
  "kind": "howto",
  "area": "settings",
  "screen": "settings.common.sidebar.lcIntegrations",
  "title": "Connect Xero",
  "blurb": "Send your Luubu invoices straight into Xero.",
  "icon": "card",
  "minutes": 4,
  "keywords": [
    "xero",
    "accounting",
    "invoices",
    "sync",
    "bookkeeping",
    "gst"
  ],
  "steps": [
    {
      "id": "open-settings",
      "title": "Open Settings",
      "body": "Click **Settings** at the bottom of the left menu.",
      "target": [
        {
          "css": "#sb_settings"
        },
        {
          "text": "Settings",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/settings/"
      }
    },
    {
      "id": "open-integrations",
      "title": "Open Integrations",
      "body": "Click **Integrations** in the Settings menu.",
      "route": "^/settings/",
      "go": "/settings/lc-integrations",
      "target": [
        {
          "css": "[id='sb_common.sidebar.lcIntegrations']"
        },
        {
          "text": "Integrations",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/settings/lc-integrations"
      }
    },
    {
      "id": "card",
      "title": "Find the Xero card",
      "body": "Click the **Xero** card, then **Connect**.",
      "route": "^/settings/lc-integrations",
      "go": "/settings/lc-integrations",
      "target": [
        {
          "text": "Xero"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Xero"
    },
    {
      "id": "login",
      "title": "Log in to Xero",
      "body": "Log in and choose your organisation, then allow access.",
      "route": "^/settings/lc-integrations",
      "go": "/settings/lc-integrations",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "account",
      "title": "Pick the account",
      "body": "Choose the default Xero account that invoices post to.",
      "route": "^/settings/lc-integrations",
      "go": "/settings/lc-integrations",
      "target": [
        {
          "coach": true
        }
      ],
      "tip": "Account missing? In Xero's chart of accounts, tick \"Enable payments to this account\"."
    },
    {
      "id": "what",
      "title": "What syncs",
      "body": "New Luubu invoices, and their status, go to Xero. Xero contacts come into Luubu. Products and payments do not sync.",
      "route": "^/settings/lc-integrations",
      "go": "/settings/lc-integrations",
      "target": [
        {
          "coach": true
        }
      ]
    }
  ]
}
