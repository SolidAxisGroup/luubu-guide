{
  "id": "settings-objects-fields",
  "kind": "howto",
  "area": "settings",
  "screen": "settings.objects",
  "title": "Add fields and links to a custom object",
  "blurb": "Choose what you record on each item, and link it to contacts.",
  "icon": "grid",
  "minutes": 4,
  "keywords": [
    "object fields",
    "associations",
    "link contacts",
    "custom object",
    "fields",
    "relationships"
  ],
  "steps": [
    {
      "id": "open-settings",
      "title": "Open Settings",
      "body": "Click **Settings** at the bottom of the left menu.",
      "target": [
        {
          "css": "#sb_settings"
        },
        {
          "text": "Settings",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/settings/"
      }
    },
    {
      "id": "open-objects",
      "title": "Open Objects",
      "body": "Click **Objects** in the Settings menu.",
      "route": "^/settings/",
      "go": "/settings/objects",
      "target": [
        {
          "css": "[id='sb_objects']"
        },
        {
          "text": "Objects",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/settings/objects"
      }
    },
    {
      "id": "open",
      "title": "Open the object",
      "body": "Click the custom object you made.",
      "route": "^/settings/objects",
      "go": "/settings/objects",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "fields",
      "title": "Add fields",
      "body": "Add the details you want to track, like Make, Model and WOF Due for a vehicle.",
      "route": "^/settings/objects",
      "go": "/settings/objects",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "unique",
      "title": "Unique fields",
      "body": "Mark a field unique (like a rego plate) to stop duplicates. Only text, number and phone fields can be unique.",
      "route": "^/settings/objects",
      "go": "/settings/objects",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "link",
      "title": "Link to contacts",
      "body": "Set up an association so each record can be linked to a contact, like a vehicle to its owner.",
      "route": "^/settings/objects",
      "go": "/settings/objects",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "use",
      "title": "Use it",
      "body": "Your records now work with workflows, forms and smart lists.",
      "route": "^/settings/objects",
      "go": "/settings/objects",
      "target": [
        {
          "coach": true
        }
      ]
    }
  ]
}
