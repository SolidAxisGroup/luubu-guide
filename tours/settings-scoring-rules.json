{
  "id": "settings-scoring-rules",
  "kind": "howto",
  "area": "settings",
  "screen": "settings.manage-scoring",
  "title": "Set up lead scoring rules",
  "blurb": "Award points for actions that show a lead is keen.",
  "icon": "star",
  "minutes": 4,
  "keywords": [
    "lead scoring",
    "rules",
    "points",
    "email opened",
    "form submitted",
    "hot leads"
  ],
  "steps": [
    {
      "id": "open-settings",
      "title": "Open Settings",
      "body": "Click **Settings** at the bottom of the left menu.",
      "target": [
        {
          "css": "#sb_settings"
        },
        {
          "text": "Settings",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/settings/"
      }
    },
    {
      "id": "open-manage-scoring",
      "title": "Open Manage Scoring",
      "body": "Click **Manage Scoring** in the Settings menu.",
      "route": "^/settings/",
      "go": "/settings/scoring",
      "target": [
        {
          "css": "[id='sb_manage-scoring']"
        },
        {
          "text": "Manage Scoring",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/settings/scoring"
      }
    },
    {
      "id": "add",
      "title": "Add a rule",
      "body": "Click **Add New Rule**.",
      "route": "^/settings/scoring",
      "go": "/settings/scoring",
      "target": [
        {
          "text": "Add New Rule",
          "tag": "button"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Add New Rule",
      "advance": "click"
    },
    {
      "id": "action",
      "title": "Pick the action",
      "body": "Choose what the contact does, for example Email Opened or Form Submitted.",
      "route": "^/settings/scoring",
      "go": "/settings/scoring",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "points",
      "title": "Set the points",
      "body": "Give it points. Big signals like a quote request deserve more than an email open. Use minus points for things like unsubscribing.",
      "route": "^/settings/scoring",
      "go": "/settings/scoring",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "save",
      "title": "Save the rule",
      "body": "Save it, and add a few more rules the same way.",
      "route": "^/settings/scoring",
      "go": "/settings/scoring",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "publish",
      "title": "Make it live",
      "body": "Switch from draft to publish in the top right so scores start counting.",
      "route": "^/settings/scoring",
      "go": "/settings/scoring",
      "target": [
        {
          "coach": true
        }
      ]
    }
  ]
}
