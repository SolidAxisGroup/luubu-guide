{
  "id": "payments-estimate-to-invoice",
  "kind": "howto",
  "area": "payments",
  "screen": "payments.payment-invoices",
  "title": "Turn an accepted estimate into an invoice",
  "blurb": "Bill the job without retyping anything.",
  "icon": "card",
  "minutes": 2,
  "keywords": [
    "estimate",
    "convert",
    "accepted quote",
    "invoice",
    "won job"
  ],
  "steps": [
    {
      "id": "open-payments",
      "title": "Open Payments",
      "body": "Click **Payments** in the left menu.",
      "target": [
        {
          "css": "#sb_payments"
        },
        {
          "text": "Payments",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/payments/"
      }
    },
    {
      "id": "tab-payment-invoices",
      "title": "Open Invoices & Estimates",
      "body": "Click **Invoices & Estimates** along the top.",
      "route": "^/payments/",
      "go": "/payments/invoices",
      "target": [
        {
          "css": "#tb_payment-invoices"
        },
        {
          "text": "Invoices & Estimates",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/payments/invoices"
      }
    },
    {
      "id": "tab",
      "title": "Open Estimates",
      "body": "Click the **Estimates** tab.",
      "route": "^/payments/invoices",
      "go": "/payments/invoices",
      "target": [
        {
          "text": "Estimates"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Estimates"
    },
    {
      "id": "find",
      "title": "Find the accepted one",
      "body": "Look for an estimate marked accepted and open it.",
      "tip": "Customer said yes on the phone? Mark it accepted yourself first.",
      "route": "^/payments/invoices",
      "go": "/payments/invoices",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "convert",
      "title": "Create the invoice",
      "body": "Use the option to create an invoice from it. All the lines and prices copy across.",
      "route": "^/payments/invoices",
      "go": "/payments/invoices",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "send",
      "title": "Send it",
      "body": "Check the due date, then click **Send**.",
      "route": "^/payments/invoices",
      "go": "/payments/invoices",
      "target": [
        {
          "text": "Send",
          "tag": "button"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Send"
    }
  ]
}
