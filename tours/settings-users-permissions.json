{
  "id": "settings-users-permissions",
  "kind": "howto",
  "area": "settings",
  "screen": "settings.my-staff",
  "title": "Set roles and permissions",
  "blurb": "Control what each person can see, like only their own leads.",
  "icon": "users",
  "minutes": 4,
  "keywords": [
    "permissions",
    "roles",
    "access",
    "admin",
    "assigned data",
    "restrict",
    "privacy"
  ],
  "steps": [
    {
      "id": "open-settings",
      "title": "Open Settings",
      "body": "Click **Settings** at the bottom of the left menu.",
      "target": [
        {
          "css": "#sb_settings"
        },
        {
          "text": "Settings",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/settings/"
      }
    },
    {
      "id": "open-users",
      "title": "Open Users",
      "body": "Click **Users** in the Settings menu.",
      "route": "^/settings/",
      "go": "/settings/users",
      "target": [
        {
          "css": "[id='sb_my-staff']"
        },
        {
          "text": "Users",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/settings/users"
      }
    },
    {
      "id": "edit",
      "title": "Edit the person",
      "body": "Click the pencil next to the team member you want to change.",
      "route": "^/settings/users",
      "go": "/settings/users",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "open-roles",
      "title": "Open roles and permissions",
      "body": "Open the roles and permissions section of their profile.",
      "route": "^/settings/users",
      "go": "/settings/users",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "role",
      "title": "Admin or User",
      "body": "**Admin** gets full access. **User** gets only the areas you switch on below.",
      "route": "^/settings/users",
      "go": "/settings/users",
      "target": [
        {
          "coach": true
        }
      ],
      "lookFor": "Admin"
    },
    {
      "id": "modules",
      "title": "Switch areas on or off",
      "body": "Go down the list and turn off anything they do not need, for example payments or workflows.",
      "route": "^/settings/users",
      "go": "/settings/users",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "assigned",
      "title": "Only their own leads",
      "body": "Turn on **Only Assigned Data** if they should only see contacts and deals assigned to them. Good for sales staff.",
      "route": "^/settings/users",
      "go": "/settings/users",
      "target": [
        {
          "coach": true
        }
      ],
      "lookFor": "Only Assigned Data"
    },
    {
      "id": "save",
      "title": "Save",
      "body": "Save. Changes apply the next time they load a page.",
      "route": "^/settings/users",
      "go": "/settings/users",
      "target": [
        {
          "coach": true
        }
      ]
    }
  ]
}
