{
  "id": "settings-page-external-tracking",
  "kind": "page",
  "area": "settings",
  "screen": "settings.external-tracking",
  "title": "Tour: External Tracking",
  "blurb": "Track visits and form fills on a website built outside Luubu.",
  "icon": "chart",
  "minutes": 2,
  "keywords": [
    "tracking",
    "script",
    "external website",
    "forms",
    "analytics",
    "wordpress"
  ],
  "steps": [
    {
      "id": "open-settings",
      "title": "Open Settings",
      "body": "Click **Settings** at the bottom of the left menu.",
      "target": [
        {
          "css": "#sb_settings"
        },
        {
          "text": "Settings",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/settings/"
      }
    },
    {
      "id": "open-external-tracking",
      "title": "Open External Tracking",
      "body": "Click **External Tracking** in the Settings menu.",
      "route": "^/settings/",
      "go": "/settings/external-tracking",
      "target": [
        {
          "css": "[id='sb_external-tracking']"
        },
        {
          "text": "External Tracking",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/settings/external-tracking"
      }
    },
    {
      "id": "what",
      "title": "What it does",
      "body": "If your main website is on WordPress, Wix or Squarespace, this script sends its form fills and visits into Luubu.",
      "route": "^/settings/external-tracking",
      "go": "/settings/external-tracking",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "copy",
      "title": "Your script",
      "body": "**Copy Script** copies your tracking code.",
      "route": "^/settings/external-tracking",
      "go": "/settings/external-tracking",
      "target": [
        {
          "text": "Copy Script",
          "tag": "button"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Copy Script"
    },
    {
      "id": "results",
      "title": "Where results show",
      "body": "Form fills create or update contacts. You can see them under **Sites**, **Forms**, then Submissions.",
      "route": "^/settings/external-tracking",
      "go": "/settings/external-tracking",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "next",
      "title": "What next",
      "body": "Next: try **Capture forms from your other website** from the Guide.",
      "route": "^/settings/external-tracking",
      "go": "/settings/external-tracking",
      "target": [
        {
          "coach": true
        }
      ]
    }
  ]
}
