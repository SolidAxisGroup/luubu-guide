{
  "id": "automation-review-request-after-job",
  "kind": "howto",
  "area": "automation",
  "screen": "automation.workflow",
  "title": "Ask for a review after a job",
  "blurb": "Send a review request automatically once the work is done.",
  "icon": "star",
  "minutes": 5,
  "keywords": [
    "review",
    "google review",
    "reputation",
    "feedback",
    "after job",
    "review request"
  ],
  "steps": [
    {
      "id": "open-automation",
      "title": "Open Automation",
      "body": "Click **Automation** in the left menu.",
      "target": [
        {
          "css": "#sb_automation"
        },
        {
          "text": "Automation",
          "tag": "a"
        }
      ],
      "advance": {
        "route": "^/automation/"
      }
    },
    {
      "id": "open-workflow",
      "title": "Open Workflows",
      "body": "Click **Workflows** at the top.",
      "route": "^/automation/",
      "go": "/automation/workflows",
      "target": [
        {
          "css": "#tb_workflow"
        },
        {
          "text": "Workflows"
        }
      ],
      "advance": {
        "route": "^/automation/workflows(?!/settings)"
      }
    },
    {
      "id": "before",
      "title": "Before you start",
      "body": "Your review link and message are set in **Reputation** settings. Check those first so the request goes to the right place.",
      "route": "^/automation/workflows(?!/settings)",
      "go": "/automation/workflows",
      "target": [
        {
          "coach": true
        }
      ]
    },
    {
      "id": "new-workflow",
      "title": "Start a new workflow",
      "body": "Click **Create Workflow** and start from scratch. At the top, rename it to something you will recognise later, like \"Review request\".",
      "route": "^/automation/workflows(?!/settings)",
      "go": "/automation/workflows",
      "target": [
        {
          "text": "Create Workflow"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Create Workflow"
    },
    {
      "id": "trigger",
      "title": "Trigger when the job is done",
      "body": "Click **Add New Trigger**. Choose **Pipeline Stage Changed** and pick your \"Job complete\" stage, or **Appointment Status** if you work from bookings.",
      "route": "^/automation/",
      "go": "/automation/workflows",
      "target": [
        {
          "text": "Add New Trigger"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Add New Trigger"
    },
    {
      "id": "wait",
      "title": "Give it a couple of hours",
      "body": "Add a **Wait** step with **A set period of time**, for example 2 hours. Asking while the job is fresh gets more reviews.",
      "route": "^/automation/",
      "go": "/automation/workflows",
      "target": [
        {
          "text": "A set period of time"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "A set period of time"
    },
    {
      "id": "request",
      "title": "Send the request",
      "body": "Add **Send Review Request** and choose SMS or email.",
      "route": "^/automation/",
      "go": "/automation/workflows",
      "target": [
        {
          "text": "Send Review Request"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Send Review Request"
    },
    {
      "id": "publish",
      "title": "Save, test and publish",
      "body": "Click **Save**. Run **Test Workflow** on your own contact, then switch **Draft** to **Publish** and save again.",
      "route": "^/automation/",
      "go": "/automation/workflows",
      "target": [
        {
          "text": "Publish"
        },
        {
          "frame": true
        },
        {
          "coach": true
        }
      ],
      "lookFor": "Publish",
      "tip": "Nothing is sent until the workflow is published."
    }
  ]
}
